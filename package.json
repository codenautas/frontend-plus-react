    "react-redux": ">=7.0.0",
    "react-router-dom": ">=6.0.0",
    "redux": ">=4.0.0",
    "redux-persist": ">=6.0.0",
    "web-vitals": ">=2.1.4",
    "zod": ">=3.24.4",
    "type-store": "*",
    "xlsx": "*",
    "like-ar": "*",
    "json4all": "^1.4.2"
