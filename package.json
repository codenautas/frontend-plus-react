    "@emotion/styled": ">=11.0.0",
    "@hookform/resolvers": ">=5.0.1",
    "@mui/icons-material": ">=5.0.0",
    "@mui/material": ">=5.0.0",
    "@reduxjs/toolkit": ">=2.8.2",
    "react": ">=17.0.0",
    "react-data-grid": ">=7.0.0-beta.0",
    "react-dom": ">=17.0.0",
