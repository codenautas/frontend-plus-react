{
  "name": "frontend-plus-react",
  "version": "0.4.1",
  "description": "librería React genérica para consumir backends de tipo backend-plus.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CLAUDE.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/index.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "keywords": [
    "react",
    "frontend",
    "generic",
    "backend-plus",
    "data-grid",
    "component-library"
  ],
  "repository": "codenautas/frontend-plus-react",
  "author": "Codenautas <codenautas@googlegroups.com>",
  "contributors": [
    {
      "name": "Manuel De la Penna",
